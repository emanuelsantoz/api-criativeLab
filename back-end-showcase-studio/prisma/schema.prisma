generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
  COORDENADOR
}

enum ProjectStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum PresentationType {
  CANVA
  POWERPOINT
  PDF
}

enum StorageProvider {
  CANVA
  VERCEL_BLOB
  CLOUDFLARE_R2
}

enum SemesterStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum InstitutionRole {
  INSTITUTION_ADMIN
  COORDINATOR
  PROFESSOR
}

enum SubmissionContextStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum SubmissionScope {
  INSTITUTION
  COURSE
  DISCIPLINE
}

model User {
  id              String          @id @default(uuid())
  name            String
  email           String          @unique
  password        String
  role            Role            @default(STUDENT)
  phone           String?
  jobTitle        String?
  department      String?
  location        String?
  bio             String?         @db.Text
  avatarUrl       String?
  notifySubmissions Boolean       @default(true)
  notifyWeeklySummary Boolean     @default(true)
  notifySearchTrends Boolean      @default(false)
  courseId        String?
  course          Course?         @relation(fields: [courseId], references: [id])
  institutionMemberships InstitutionMembership[]
  projects        ProjectMember[]
  likes           Like[]
  createdProjects Project[]       @relation("ProjectCreator")
  reviews         ProjectReview[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([email])
}

model Course {
  id              String           @id @default(uuid())
  institutionId   String
  name            String
  description     String?
  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  users           User[]
  projects        Project[]
  semesterCourses SemesterCourse[]

  submissionContexts SubmissionContext[]
  courseDisciplines CourseDiscipline[]

  @@unique([institutionId, name])
  @@index([institutionId])
}

model InstitutionType {
  id           String        @id @default(uuid())
  name         String        @unique
  slug         String        @unique
  institutions Institution[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Institution {
  id                String                  @id @default(uuid())
  name              String
  slug              String                  @unique
  institutionTypeId String
  logoUrl           String?
  websiteUrl        String?
  active            Boolean                 @default(true)
  institutionType   InstitutionType         @relation(fields: [institutionTypeId], references: [id], onDelete: Restrict)
  memberships       InstitutionMembership[]
  courses           Course[]
  disciplines       Discipline[]
  academicPeriods   AcademicPeriod[]
  submissionContexts SubmissionContext[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([institutionTypeId])
  @@index([active])
}

model InstitutionMembership {
  institutionId String
  userId        String
  role          InstitutionRole
  active        Boolean     @default(true)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@id([institutionId, userId])
  @@index([userId, active])
}

model AcademicPeriod {
  id            String        @id @default(uuid())
  institutionId String
  code          String
  label         String
  startsAt      DateTime?
  endsAt        DateTime?
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  submissionContexts SubmissionContext[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([institutionId, code])
  @@index([institutionId])
}

model Discipline {
  id            String        @id @default(uuid())
  institutionId String
  name          String
  code          String?
  description   String?
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courseDisciplines CourseDiscipline[]
  submissionContexts SubmissionContext[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([institutionId, name])
  @@unique([institutionId, code])
  @@index([institutionId])
}

model CourseDiscipline {
  courseId          String
  disciplineId      String
  recommendedPeriod Int?
  required          Boolean    @default(false)
  course            Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  discipline        Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade)

  @@id([courseId, disciplineId])
  @@index([disciplineId])
}

model SubmissionContext {
  id                 String                  @id @default(uuid())
  institutionId      String
  academicPeriodId   String?
  courseId           String?
  disciplineId       String?
  scope              SubmissionScope
  status             SubmissionContextStatus @default(DRAFT)
  name               String
  className          String?
  theme              String?
  submissionsOpenAt  DateTime?
  submissionsCloseAt DateTime?
  institution        Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  academicPeriod     AcademicPeriod?         @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  course             Course?                 @relation(fields: [courseId], references: [id], onDelete: SetNull)
  discipline         Discipline?             @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  tags               SubmissionContextTag[]
  projects           Project[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([institutionId, status])
  @@index([academicPeriodId])
  @@index([courseId])
  @@index([disciplineId])
}

model SubmissionContextTag {
  submissionContextId String
  tagId               String
  submissionContext   SubmissionContext @relation(fields: [submissionContextId], references: [id], onDelete: Cascade)
  tag                 Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([submissionContextId, tagId])
  @@index([tagId])
}

model Tag {
  id              String             @id @default(uuid())
  name            String             @unique
  semesterCourses SemesterCourseTag[]
  submissionContexts SubmissionContextTag[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Project {
  id                       String               @id @default(uuid())
  slug                     String               @unique
  title                    String
  shortDescription         String
  description              String               @db.Text
  submitterName            String?
  submitterEmail           String?
  submitterAvatarUrl       String?
  submitterAvatarColor     String?
  revision                 Int                  @default(1)
  thumbnailUrl             String?
  thumbnailStorageProvider StorageProvider?
  thumbnailStorageKey      String?
  status                   ProjectStatus        @default(PENDING_REVIEW)
  isFeatured               Boolean              @default(false)
  viewsCount               Int                  @default(0)
  likesCount               Int                  @default(0)
  tags                     String[]             @default([])
  liveUrl                  String?
  prototypeUrl             String?
  repositoryUrl            String?
  courseId                 String
  className                String               @default("Turma única")
  course                   Course               @relation(fields: [courseId], references: [id])
  semesterId               String
  semester                 Semester             @relation(fields: [semesterId], references: [id])
  submissionContextId      String?
  submissionContext        SubmissionContext?   @relation(fields: [submissionContextId], references: [id], onDelete: SetNull)
  createdById              String?
  createdBy                User?                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members                  ProjectMember[]
  contributors             ProjectContributor[]
  likes                    Like[]
  anonymousLikes           AnonymousLike[]
  anonymousViews           AnonymousView[]
  presentation             ProjectPresentation?
  reviews                  ProjectReview[]
  accessTokens             ProjectAccessToken[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([status, isFeatured])
  @@index([courseId])
  @@index([semesterId, className, status])
  @@index([createdById])
  @@index([submissionContextId])
}

model Semester {
  id        String           @id @default(uuid())
  year      Int
  number    Int
  code      String           @unique
  label     String
  startsAt  DateTime
  endsAt    DateTime
  status    SemesterStatus   @default(DRAFT)
  projects  Project[]
  courses   SemesterCourse[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([year, number])
  @@index([status, startsAt])
}

model SemesterCourse {
  semesterId String
  courseId   String
  className  String   @default("Turma única")
  theme      String?
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tags       SemesterCourseTag[]

  @@id([semesterId, courseId, className])
  @@index([courseId])
}

model SemesterCourseTag {
  semesterId String
  courseId   String
  className  String
  tagId      String
  semesterCourse SemesterCourse @relation(fields: [semesterId, courseId, className], references: [semesterId, courseId, className], onDelete: Cascade)
  tag        Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([semesterId, courseId, className, tagId])
  @@index([tagId])
}

model ProjectReview {
  id         String         @id @default(uuid())
  projectId  String
  reviewerId String
  decision   ReviewDecision
  reason     String?        @db.Text
  createdAt  DateTime       @default(now())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([reviewerId])
}

model ProjectAccessToken {
  id        String    @id @default(uuid())
  projectId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt])
}

model ProjectPresentation {
  id              String           @id @default(uuid())
  projectId       String           @unique
  type            PresentationType
  url             String
  storageProvider StorageProvider
  storageKey      String?
  contentType     String?
  sizeBytes       Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectMember {
  projectId String
  userId    String
  roleInfo  String?
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model ProjectContributor {
  id        String   @id @default(uuid())
  projectId String
  name      String
  email     String?
  roleInfo  String?
  avatarUrl String?
  avatarColor String?
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Like {
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
}

model AnonymousLike {
  projectId   String
  visitorHash String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, visitorHash])
  @@index([projectId])
}

// Não contém nome, e-mail, IP ou conta: somente o hash de um UUID aleatório
// criado pelo navegador para impedir contagem repetida por projeto.
model AnonymousView {
  projectId   String
  visitorHash String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, visitorHash])
  @@index([projectId])
}

// Visita diária única por navegador. Persiste somente o hash de um UUID
// aleatório; não há conta, nome, e-mail nem endereço IP associado.
model SiteVisit {
  visitorHash String
  day         DateTime @db.Date
  createdAt   DateTime @default(now())

  @@id([visitorHash, day])
  @@index([day])
}

// Histórico administrativo sem copiar conteúdo, e-mails ou tokens de acesso.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  resource    String
  resourceId  String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([resource, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}
